# Settings read from the environment by cookOverflow/settings.py.
# Everything is optional for local development; the defaults below are what you get when unset.

# --- Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=            # comma-separated, e.g. cookoverflow.example.com

# --- Database (SQLite by default)
DB_ENGINE=                       # set to "postgres" to use PostgreSQL
DB_NAME=cookoverflow
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (printed to the console by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=             # for Gmail, use an app password
EMAIL_FROM_USER=
EMAIL_VERIFICATION_REQUIRED=     # defaults to true only when EMAIL_BACKEND is SMTP

# --- Fridge scan (off unless a key is set; each scan is one paid Gemini API call)
GEMINI_API_KEY=
COOK_SCAN_MODEL=gemini-3.1-flash-lite
COOK_SCAN_TIMEOUT=30             # seconds

# --- AI: Sous-chef chat, reply drafts, post drafts from a prompt, photos or a video (off until a provider is set)
# Gemini is the default and uses GEMINI_API_KEY above. A free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini               # or "openai" for any OpenAI-compatible endpoint (examples below)
AI_MODEL=gemini-3.8-flash        # on the free tier
AI_API_KEY=                      # defaults to GEMINI_API_KEY for gemini
AI_BASE_URL=                     # openai only
AI_TIMEOUT=60                    # seconds per model call
AI_MAX_VIDEO_MB=20               # bigger videos go to the model as stills picked in the browser
AI_ASSISTANT_USERNAME=sous_chef  # the assistant's account, reserved at sign-up
#
# OpenAI-compatible examples (check each provider's model list; names change):
#   GitHub Models, free with a GitHub token that has models:read
#     AI_PROVIDER=openai  AI_BASE_URL=https://models.github.ai/inference  AI_MODEL=openai/gpt-4.1-mini  AI_API_KEY=<token>
#   Groq, free tier
#     AI_PROVIDER=openai  AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=<a vision model>  AI_API_KEY=<key>
#   Ollama on this machine, no key at all (ollama pull qwen2.5vl)
#     AI_PROVIDER=openai  AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=qwen2.5vl
