# Settings read from the environment by cookOverflow/settings.py.
# Everything is optional for local development; the defaults below are what you get when unset.

# --- Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=            # comma-separated, e.g. cookoverflow.example.com

# --- Database (SQLite by default)
DB_ENGINE=                       # set to "postgres" to use PostgreSQL
DB_NAME=cookoverflow
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (printed to the console by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=             # for Gmail, use an app password
EMAIL_FROM_USER=
EMAIL_VERIFICATION_REQUIRED=     # defaults to true only when EMAIL_BACKEND is SMTP
